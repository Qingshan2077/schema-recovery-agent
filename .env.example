# Database used by local Python scripts
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=schema_recovery_pwd
DB_NAME=schema_recovery_demo

# MySQL container bootstrap
MYSQL_ROOT_PASSWORD=schema_recovery_pwd
MYSQL_DATABASE=schema_recovery_demo
MYSQL_HOST_PORT=3307
MYSQL_CONTAINER_PORT=3306

# API
API_HOST=0.0.0.0
API_PORT=8080

# Runtime paths
DATA_DIR=data
DOCKER_DATA_DIR=/app/data

# LangGraph
LANGGRAPH_ENABLED=true

# Phase 3 worker rollout: legacy | hybrid | shadow
WORKER_IMPL_SURVEY=hybrid
WORKER_IMPL_COLUMN=hybrid
WORKER_IMPL_NAME=hybrid
WORKER_IMPL_CODE=hybrid
WORKER_IMPL_ORM=hybrid
WORKER_IMPL_MERGE=hybrid
EVIDENCE_LEDGER_DUAL_WRITE=true
EVIDENCE_DB_PATH=data/evidence/evidence.db
CRITIC_ENABLED=true
RUN_MAX_EVIDENCE_ROUNDS=2
WORK_UNIT_TIMEOUT_SECONDS=120
WORK_UNIT_MAX_MODEL_CALLS=2
FUSION_MODEL_VERSION=log_odds_v3
FUSION_WEIGHT_VERSION=phase5-feature-schema-v1

# Phase 4 orchestration
RECOVERY_ENGINE=auto_v2
CHECKPOINT_BACKEND=sqlite
STORE_BACKEND=sqlite
WORKFLOW_VERSION=schema-recovery-v2
STATE_SCHEMA_VERSION=2
RECOVERY_RUN_DB_PATH=data/workflow/runs.db
LANGGRAPH_CHECKPOINT_DB_PATH=data/workflow/langgraph-checkpoints.db
LANGGRAPH_POSTGRES_DSN=
AUTO_FALLBACK_ENABLED=true
RUN_MAX_AUTO_FALLBACKS=1
WORKFLOW_MAX_CONCURRENCY=4
WORKFLOW_MAX_STAGE_ATTEMPTS=2
WORKFLOW_RECURSION_LIMIT=32

# Phase 5 memory and calibrated evidence fusion
MEMORY_V2_READ_ENABLED=true
MEMORY_V2_WRITE_ENABLED=true
MEMORY_VECTOR_ENABLED=true
EVIDENCE_LEDGER_ENABLED=true
FUSION_V2_ENABLED=true
CALIBRATION_ENABLED=true
MEMORY_INSPECTOR_ENABLED=true
MEMORY_V2_DB_PATH=data/memory/memory-v2.db
MEMORY_L1_ACTIVE_TTL_DAYS=7
MEMORY_L1_COMPLETED_TTL_DAYS=30
MEMORY_L3_CANDIDATE_TTL_DAYS=60
MEMORY_CONTEXT_MAX_TOKENS=4000
MEMORY_RETRIEVAL_TOP_K=20
MEMORY_VECTOR_PROVIDER=
FUSION_POLICY_PATH=data/calibration/fusion-policy.json
FUSION_FEATURE_SCHEMA_PATH=data/calibration/fusion-feature-schema.json
EVAL_V2_ENABLED=true
EVAL_V2_DB_PATH=data/eval/eval-v2.db
EVAL_ARTIFACT_DIR=data/eval/eval-artifacts
EVAL_DATASET_REGISTRY_PATH=data/eval/registry.json
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=schema-recovery-agent
TRACE_DB_PATH=data/observability/traces.db
TRACE_PAYLOAD_CAPTURE=false
JUDGE_V2_ENABLED=false
CI_GATE_ENFORCED=false
DBA_V2_ENABLED=true
DBA_PLAN_ENABLED=true
DBA_EXECUTION_ENABLED=false
DBA_OPERATION_DB_PATH=data/dba/operations.db
DBA_OPERATION_TTL_MINUTES=30
DBA_ALLOWED_ENVIRONMENTS=dev,staging
DBA_EXECUTION_CONNECTION_ALLOWLIST=
AGENT_WORKBENCH_ENABLED=true
RUN_INSPECTOR_ENABLED=true
EVIDENCE_WORKBENCH_ENABLED=true
ER_EXPLORER_V2_ENABLED=true
APPROVAL_CENTER_ENABLED=true
DEPLOYMENT_GIT_SHA=unknown
DEPLOYMENT_DIRTY_WORKTREE=true

# Optional LLM judge
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Evidence fusion weights
WEIGHT_CODE=0.40
WEIGHT_ORM=0.25
WEIGHT_COLUMN=0.20
WEIGHT_NAME=0.15
